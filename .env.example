# Copia este archivo como .env y completa con tus valores reales

# MongoDB (usado por algunas funcionalidades)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="prados_legal_hub"

# CORS
CORS_ORIGINS="*"

# LLM - OpenAI (obtener en https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key

# HeyGen - Avatar y LiveAvatar (obtener en https://heygen.com)
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_AVATAR_ID=your-avatar-id

# ElevenLabs - Síntesis de voz (obtener en https://elevenlabs.io)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-agent-id

# LiveAvatar (si usas API directa)
LIVEAVATAR_API_KEY=your-liveavatar-key
LIVEAVATAR_AVATAR_ID=your-liveavatar-id

# SQLite - Base de conocimiento (opcional; en Render usa /tmp si no se define)
# SQLITE_DB_PATH=/tmp/prados.db
