# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# MongoDB Configuration
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=prados_legal_hub

# ElevenLabs TTS/STT (optional)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# HeyGen Avatar (optional)
HEYGEN_API_KEY=your-heygen-api-key-here
HEYGEN_AVATAR_ID=your-heygen-avatar-id-here

# SQLite base de conocimiento (opcional; por defecto en Render usa /tmp/prados.db)
# SQLITE_DB_PATH=/tmp/prados.db

# En Render con 512MB: desactivar embeddings para no quedarse sin memoria (búsqueda por palabras clave)
# DISABLE_EMBEDDINGS=1

# Server Configuration (optional)
# HOST=0.0.0.0
# PORT=8000
